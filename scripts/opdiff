#!/usr/bin/env bash
# opdiff — open the opdiff app for the current repository.
#
#   opdiff                     compare current branch against the default base (origin/HEAD, main, …)
#   opdiff <base>              compare current branch against <base>
#   opdiff <base> <head>       compare <head> against <base>
#   opdiff -c [base]           committed changes only (uncommitted + untracked
#                              work is included by default)
#
# Also installed as git-opdiff, so `git opdiff ...` works too.
set -euo pipefail

args=()
positional=()
for arg in "$@"; do
  case "$arg" in
    -c|--committed-only) args+=(--committed-only) ;;
    -u|--uncommitted) ;;  # default now; kept for compatibility
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) positional+=("$arg") ;;
  esac
done

root="$(git rev-parse --show-toplevel)"
args+=(--repo "$root")
if [ "${#positional[@]}" -ge 1 ]; then args+=(--base "${positional[0]}"); fi
if [ "${#positional[@]}" -ge 2 ]; then args+=(--head "${positional[1]}"); fi

app="${OPDIFF_APP:-}"
if [ -z "$app" ]; then
  for candidate in "$HOME/Applications/opdiff.app" "/Applications/opdiff.app"; do
    if [ -d "$candidate" ]; then app="$candidate"; break; fi
  done
fi
if [ -z "$app" ]; then
  echo "opdiff: opdiff.app not found. Run 'make install' in the opdiff repo, or set OPDIFF_APP." >&2
  exit 1
fi

# -n: new instance per invocation, so each call opens its own window with these arguments.
open -n "$app" --args "${args[@]}"
